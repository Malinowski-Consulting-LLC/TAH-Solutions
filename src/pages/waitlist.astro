---
/**
 * Waitlist page — waitlist.astro
 * Hero + course features + WaitlistForm.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import FeaturesList from '../components/FeaturesList.astro';
---

<BaseLayout
  title="EMS Clinical Infrastructure Course Waitlist"
  description="Join the waitlist for the EMS Clinical Infrastructure course. 10 self-paced modules covering protocol design, QA/QI implementation, and standard of care infrastructure."
  ogImage="/images/courses.webp"
>
  <Hero
    variant="waitlist"
    label="Coming Soon"
    titleHtml={`EMS Clinical<br>Infrastructure <em>Course</em>`}
    body="A 10-module self-paced course for medical directors, agency leadership, and QA/QI coordinators who want to build a real clinical infrastructure program."
  />

  <section style="padding: var(--tah-spacing-section) 0;">
    <div class="container" style="max-width: 900px;">
      <div style="display: grid; grid-template-columns: 1fr; gap: var(--tah-spacing-xxl);">
        <div class="reveal">
          <p class="text-label" style="margin-bottom: var(--tah-spacing-md);">What You&rsquo;ll Learn</p>
          <h2 style="font-family: var(--tah-font-serif); margin-bottom: var(--tah-spacing-xl);">From gap assessment to operational rollout</h2>
          <p style="color: var(--tah-text-secondary); line-height: 1.7; margin-bottom: var(--tah-spacing-lg);">A practical, evidence-based curriculum designed by EMS operators for EMS operators. Walk away with the templates, frameworks, and implementation playbooks you need to build or rebuild your agency&rsquo;s clinical infrastructure.</p>
          <FeaturesList items={[
            { text: '10 modules covering the full clinical infrastructure lifecycle, from gap assessment to operational rollout' },
            { text: 'Self-paced format. Complete on your schedule, at your agency&rsquo;s pace.' },
            { text: 'Downloadable templates, checklists, and implementation guides' },
            { text: 'Built for EMS medical directors, agency leadership, and QA/QI coordinators' },
            { text: 'Evidence-based content aligned with NAEMSP &amp; AHA standards' },
            { text: 'Early access pricing for waitlist members' },
          ]} />
        </div>

        <div class="reveal reveal--d1">
          <WaitlistForm />
        </div>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="container">
      <p class="text-label reveal" style="color: var(--tah-secondary); margin-bottom: var(--tah-spacing-md);">While You Wait</p>
      <h2 class="reveal reveal--d1">Start with the free checklist</h2>
      <p class="reveal reveal--d2">Our 20-question Protocol Gap Audit Checklist covers the same foundation as Module 1. Get a head start before the course launches.</p>
      <div class="reveal reveal--d3" style="margin-top: var(--tah-spacing-xl);">
        <Button href={`${import.meta.env.BASE_URL}checklist`} variant="accent" size="lg">Get the Free Checklist</Button>
      </div>
    </div>
  </section>
</BaseLayout>
