---
/**
 * 404 page — 404.astro
 * Custom 404 for any unmatched route. Centered layout with a large gold "404"
 * and clear next-step actions.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { NAV } from '../consts';
---

<BaseLayout title="404: Page Not Found" noindex={true} showFloatingCta={false}>
  <section class="not-found section-with-watermark">
    <div class="section-watermark" aria-hidden="true">404</div>
    <div class="container">
      <div class="not-found__code reveal">404</div>
      <h1 class="not-found__title reveal reveal--d1">We can&rsquo;t find that page</h1>
      <p class="not-found__body reveal reveal--d2">The link you followed may be broken, or the page may have been moved. Try one of these instead.</p>
      <div class="reveal reveal--d3" style="display: flex; gap: var(--tah-spacing-md); flex-wrap: wrap; justify-content: center; margin-bottom: var(--tah-spacing-xxl);">
        <Button href={`${import.meta.env.BASE_URL}/`} variant="accent" size="lg">Back to Home</Button>
        <Button href={`${import.meta.env.BASE_URL}/contact`} variant="outline" size="lg">Contact Us</Button>
      </div>

      <div class="reveal reveal--d4" style="max-width: 600px; margin: 0 auto;">
        <p class="text-label" style="margin-bottom: var(--tah-spacing-md); text-align: center;">Or Try One of These</p>
        <div style="display: flex; flex-wrap: wrap; gap: var(--tah-spacing-sm); justify-content: center;">
          {NAV.filter(n => n.href !== '/').slice(0, 5).map((link) => (
            <a
              href={`${import.meta.env.BASE_URL}${link.href}`}
              class="btn btn--sm"
              style="background: var(--tah-bg-soft); color: var(--tah-text); border-color: var(--tah-border);"
            >{link.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
