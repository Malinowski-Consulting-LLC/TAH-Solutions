---
/**
 * MiniNav.astro
 * Compact top-of-page nav bar that appears on scroll. Has the logo
 * and a small hamburger button that opens the same MenuOverlay.
 */
import { SITE } from '../consts';

export interface NavLink {
  label: string;
  href: string;
}

export interface Props {
  links: readonly NavLink[];
}

const { links } = Astro.props;
---

<nav class="mini-nav" data-mini-nav aria-label="Site navigation">
  <a href={`${import.meta.env.BASE_URL}`}>
    <img src={`${import.meta.env.BASE_URL}images/logo.webp`} alt={SITE.name} class="mini-nav__logo" width="120" height="36">
  </a>
  <button class="mini-nav__trigger" aria-label="Open navigation menu" data-mini-trigger type="button">
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>
