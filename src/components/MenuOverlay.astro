---
/**
 * MenuOverlay.astro
 * Full-screen navigation overlay. Opens when the floating MenuTrigger
 * is clicked. Includes the logo, page links, and a footer tagline.
 */
import { SITE } from '../consts';
import type { CollectionEntry } from 'astro:content';

export interface NavLink {
  label: string;
  href: string;
}

export interface Props {
  links: readonly NavLink[];
}

const { links } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div class="menu-overlay" data-menu-overlay aria-hidden="true">
  <div class="menu-overlay__inner">
    <img src={`${import.meta.env.BASE_URL}images/logo.webp`} alt={SITE.name} class="menu-overlay__logo" width="120" height="120">
    <nav class="menu-overlay__links" aria-label="Primary navigation">
      {links.map((link) => {
        const normalized = link.href.replace(/\/$/, '') || '/';
        const isActive = currentPath === normalized;
        const resolvedHref = link.href === '/' ? baseUrl : `${baseUrl}${link.href.replace(/^\//, '')}`;
        return (
          <a href={resolvedHref} class={isActive ? 'active' : ''}>{link.label}</a>
        );
      })}
    </nav>
    <div class="menu-overlay__footer">
      <p>{SITE.tagline}</p>
    </div>
  </div>
</div>
