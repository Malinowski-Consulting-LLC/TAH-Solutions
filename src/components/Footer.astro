---
/**
 * Footer.astro
 * Site-wide footer with brand block, three link columns, disclaimer,
 * gold copyright, "Made with ❤️ in Texas" decorative line, and a
 * subtle "Built by Malinowski Consulting" attribution.
 */
import { SITE, SERVICES, NAV } from '../consts';
const year = SITE.copyrightYear;
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <img src={`${import.meta.env.BASE_URL}images/logo.webp`} alt={SITE.name} class="footer__brand-img" width="160" height="36">
        <p class="footer__desc">Building clinical infrastructure for EMS agencies. Evidence-based protocols, QA/QI programs, and expert consulting.</p>
      </div>

      <div>
        <h4 class="footer__heading">Services</h4>
        <ul class="footer__links">
          {SERVICES.map((s) => (
            <li><a href={`${import.meta.env.BASE_URL}services#${s.id}`}>{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer__heading">Company</h4>
        <ul class="footer__links">
          <li><a href={`${import.meta.env.BASE_URL}about`}>About</a></li>
          <li><a href={`${import.meta.env.BASE_URL}contact`}>Contact</a></li>
          <li><a href={`${import.meta.env.BASE_URL}checklist`}>Free Checklist</a></li>
        </ul>
      </div>

      <div>
        <h4 class="footer__heading">Resources</h4>
        <ul class="footer__links">
          <li><a href={`${import.meta.env.BASE_URL}waitlist`}>Course Waitlist</a></li>
          <li><a href={`${import.meta.env.BASE_URL}terms`}>Terms of Service</a></li>
          <li><a href={`${import.meta.env.BASE_URL}privacy`}>Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__disclaimer">
      <p>
        <strong>Disclaimer:</strong> TAH Solutions provides informational consulting services only. We do not provide medical advice or legal advice. The information on this website is for general informational purposes and should not be relied upon as a substitute for professional medical or legal counsel.
      </p>
      <p class="copyright">&copy; {year} {SITE.name}. All rights reserved.</p>
      <div class="footer-meta">
        Made with <span class="heart">❤️</span> in <img src={`${import.meta.env.BASE_URL}images/texas.svg`} alt="Texas" class="texas-icon" width="24" height="24">
      </div>
      <p class="footer-built">
        Built by <a href={SITE.builtBy.url} rel="noopener" target="_blank">{SITE.builtBy.name}</a>
      </p>
    </div>
  </div>
</footer>
