---
/**
 * ChecklistForm.astro
 * Free PDF checklist download. Form-gated delivery — user fills out
 * the form, submits to Google Forms, and the PDF download starts
 * immediately on success.
 *
 * Client-side validation is handled by `scripts/form-validation.ts`.
 */
import { GOOGLE_FORMS, googleFormActionUrl } from '../consts';

const formId = 'checklist';
const action = googleFormActionUrl(GOOGLE_FORMS.checklist.formId);
const entries = GOOGLE_FORMS.checklist.entries;
const iframeName = `hidden_iframe_${formId}`;
const pdfFilename = 'TAH_Solutions_Protocol_Gap_Audit_Checklist.pdf';
---

<div class="landing-form">
  <h2 style="font-family: var(--tah-font-serif); margin-bottom: var(--tah-spacing-sm); font-size: var(--tah-font-size-h4);">Download the Checklist</h2>
  <p style="font-size: var(--tah-font-size-small); color: var(--tah-text-secondary); margin-bottom: var(--tah-spacing-xl);">Free. No commitment. Delivered to your inbox in seconds.</p>

  <div class="form-error-summary" role="alert" data-form-summary={formId} hidden>
    <p>Please fix the errors below and try again.</p>
  </div>

  <iframe name={iframeName} id={iframeName} style="display:none;" title="hidden submission target" aria-hidden="true"></iframe>

  <form
    action={action}
    method="POST"
    target={iframeName}
    onsubmit={`return tahValidate(event, '${formId}', ['name','email','agency','role']);`}
    data-form={formId}
    novalidate
  >
    <div class="form-group">
      <label class="form-label form-required" for="checklist-name">Full Name</label>
      <input
        type="text"
        id="checklist-name"
        name={`entry.${entries.name}`}
        class="form-input"
        data-field="name"
        required
        autocomplete="name"
        maxlength="100"
        aria-describedby="checklist-name-error"
      >
      <div class="field-error" id="checklist-name-error" data-field-error="name" role="alert" hidden></div>
    </div>
    <div class="form-group">
      <label class="form-label form-required" for="checklist-email">Email</label>
      <input
        type="email"
        id="checklist-email"
        name={`entry.${entries.email}`}
        class="form-input"
        data-field="email"
        required
        autocomplete="email"
        maxlength="254"
        aria-describedby="checklist-email-error"
      >
      <div class="field-error" id="checklist-email-error" data-field-error="email" role="alert" hidden></div>
    </div>
    <div class="form-group">
      <label class="form-label" for="checklist-agency">Agency Name <span style="color: var(--tah-text-muted); font-weight: 400;">(optional)</span></label>
      <input
        type="text"
        id="checklist-agency"
        name={`entry.${entries.agency}`}
        class="form-input"
        data-field="agency"
        autocomplete="organization"
        maxlength="200"
        aria-describedby="checklist-agency-error"
      >
      <div class="field-error" id="checklist-agency-error" data-field-error="agency" role="alert" hidden></div>
    </div>
    <div class="form-group">
      <label class="form-label" for="checklist-role">Your Role <span style="color: var(--tah-text-muted); font-weight: 400;">(optional)</span></label>
      <select
        id="checklist-role"
        name={`entry.${entries.role}`}
        class="form-select"
        data-field="role"
        aria-describedby="checklist-role-error"
      >
        <option value="">Select your role</option>
        <option value="Medical Director">Medical Director</option>
        <option value="Agency Leadership / Chief">Agency Leadership / Chief</option>
        <option value="QA/QI Coordinator">QA/QI Coordinator</option>
        <option value="Field Provider">Field Provider</option>
        <option value="Other">Other</option>
      </select>
      <div class="field-error" id="checklist-role-error" data-field-error="role" role="alert" hidden></div>
    </div>
    <button type="submit" class="btn btn--accent" style="width: 100%;">
      <span class="btn-label">Get the Free Checklist</span>
      <span class="spinner" aria-hidden="true"></span>
    </button>
  </form>

  <div data-form-success={formId} hidden class="form-success-checklist">
    <p class="form-success-checklist__title">Your download is ready.</p>
    <a
      href="#"
      download={pdfFilename}
      class="btn btn--accent form-success-checklist__download"
      data-checklist-download
      data-pdf-host="drive.google.com"
      data-pdf-path="/uc"
      data-pdf-params="export=download&id=1j3BAAATVYr4nSGrIHOjQ7JdPLx7Kvxwo"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span>Download the Checklist (PDF)</span>
    </a>
    <p class="form-success-checklist__note">
      Saved a copy to your downloads folder. We&rsquo;ll also reach out within a few days to see how the audit went. Questions in the meantime? <a href={`mailto:${Astro.props.fallbackEmail || 'info@tahsolutions.com'}`}>Email us</a>.
    </p>
  </div>

  <script>
    // Assemble the PDF URL from data attributes on the link. The actual
    // download URL never appears in the rendered HTML source.
    function buildPdfUrl(btn: HTMLAnchorElement): string {
      const proto = 'https';
      const host = btn.dataset.pdfHost ?? '';
      const path = btn.dataset.pdfPath ?? '';
      const params = btn.dataset.pdfParams ?? '';
      return `${proto}://${host}${path}?${params}`;
    }

    function wireChecklistDownload() {
      const btn = document.querySelector<HTMLAnchorElement>('[data-checklist-download]');
      if (!btn) return;
      // Wire the real href on the link so the visible button works
      btn.href = buildPdfUrl(btn);

      // Auto-click the download link only AFTER the form has been
      // submitted and the success block is shown. The success block is
      // revealed by `tahSubmitted()` in BaseLayout.astro ~1.2s after the
      // form posts to Google Forms. We watch for the `hidden` attribute
      // to flip off rather than guessing a timer.
      const success = document.querySelector<HTMLElement>('[data-form-success="checklist"]');
      if (!success || !success.hidden) return;
      if ((window as any).__tahChecklistAutoDownloaded) return;
      (window as any).__tahChecklistAutoDownloaded = true;

      const observer = new MutationObserver(() => {
        if (!success.hidden) {
          observer.disconnect();
          // Small delay so the user sees the success state first
          setTimeout(() => btn.click(), 400);
        }
      });
      observer.observe(success, { attributes: true, attributeFilter: ['hidden'] });
    }

    // Run on initial page load (no view transitions on this static site)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wireChecklistDownload);
    } else {
      wireChecklistDownload();
    }
    // Also handle Astro view transitions if they get added later
    document.addEventListener('astro:page-load', wireChecklistDownload);
  </script>
</div>
