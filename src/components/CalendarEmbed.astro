---
/**
 * CalendarEmbed.astro
 * "Schedule with Google" appointment booking button.
 * Clicking opens the user's Google Appointment Schedule in a new tab.
 * This is more privacy-friendly than embedding a public iframe —
 * the user's calendar stays private until they actively book a time.
 */
import { CALENDAR } from '../consts';
export interface Props {
  title?: string;
  description?: string;
  fallbackEmail?: string;
}

const {
  title = 'Pick a time on the calendar',
  description = 'Free 30-minute discovery call. Times shown in Central Time (America/Chicago).',
  fallbackEmail,
} = Astro.props;
---

<section style="padding: 0 0 var(--tah-spacing-section) 0;">
  <div class="container">
    <div class="reveal" style="text-align: center; max-width: 800px; margin: 0 auto var(--tah-spacing-xl);">
      <p class="text-label" style="color: var(--tah-secondary); margin-bottom: var(--tah-spacing-md);">Or Book Directly</p>
      <h2 style="font-family: var(--tah-font-serif); margin-bottom: var(--tah-spacing-md);">{title}</h2>
      <p style="color: var(--tah-text-secondary);">{description}</p>
    </div>

    <div class="reveal reveal--d1 calendar-booking">
      <a
        href={CALENDAR.bookingUrl}
        target="_blank"
        rel="noopener"
        class="calendar-booking__button"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Schedule with Google</span>
        <svg class="calendar-booking__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <p class="calendar-booking__note">
        Opens Google Calendar's booking page in a new tab. You&rsquo;ll pick a time, and Google will send a calendar invite with a Meet link.
      </p>
    </div>

    {fallbackEmail && (
      <p class="reveal reveal--d2" style="text-align: center; margin-top: var(--tah-spacing-md); font-size: var(--tah-font-size-small); color: var(--tah-text-secondary);">
        Don&rsquo;t see a time that works? <a href={`mailto:${fallbackEmail}`} style="color: var(--tah-secondary-dark);">Email us</a> and we&rsquo;ll find one.
      </p>
    )}
  </div>
</section>
